rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Dynamic Quizzes management
    match /quizzes/{quizId} {
      allow read, write: if true;
    }

    // Global App Configuration (active quiz pointer, 4-hour live schedule)
    match /config/{configId} {
      allow read, write: if true;
    }

    // Helper function for anti-cheat validation
    function isValidResult(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.phoneNumber is string && data.phoneNumber.size() >= 8 && data.phoneNumber.size() <= 30 &&
             data.score is number && data.score >= 0 &&
             data.totalQuestions is number && data.totalQuestions > 0 &&
             data.score <= data.totalQuestions &&
             data.timeTaken is number && data.timeTaken >= 0 &&
             (!('verificationHash' in data) || (data.verificationHash is string && data.verificationHash.size() == 64));
    }

    // Results collection - strictly validated, immutable writes
    match /results/{resultId} {
      allow create: if isValidResult(request.resource.data);
      allow read, delete: if true;
      allow update: if false;
    }

    // Legacy collections support
    match /krishna_janamotsav_results/{resultId} {
      allow create: if isValidResult(request.resource.data);
      allow read, delete: if true;
      allow update: if false;
    }

    match /foundation_day_results/{resultId} {
      allow create: if isValidResult(request.resource.data);
      allow read, delete: if true;
      allow update: if false;
    }
  }
}
